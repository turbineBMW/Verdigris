# Allow the iphonebridge user daemon to set the adapter CoD without a
# password prompt. The single specific command is the only thing this
# rule unlocks — btmgmt with any other arguments still requires a
# password. See spike/RESULTS.md §1 for why this command is load-bearing.
#
# Install with:
#   sudo bash systemd/install-cod-sudoers.sh
# (sudo visudo-checks the file before copying it into /etc/sudoers.d/)

bash ALL=(root) NOPASSWD: /usr/bin/btmgmt class 4 8
