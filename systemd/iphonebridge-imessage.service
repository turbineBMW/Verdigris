[Unit]
Description=iphonebridge iMessage transport (ib-imessage)
Documentation=https://github.com/gabrielmeir53/iphonebridge
# Needs the network to reach Apple's APNs/IDS, and the runtime dir for its
# socket. Nothing Bluetooth-related: this transport talks to Apple directly,
# not to the phone, which is the whole point of it.
After=network-online.target
Wants=network-online.target

# IMPORTANT: this service and the OpenBubbles app share one APNs push token,
# and Apple permits a single connection per token — run both and they displace
# each other in a loop until one stops. OpenBubbles is a Flatpak launched from
# the desktop, not a unit, so systemd cannot enforce this with Conflicts=.
# Stop this service before opening OpenBubbles to renew the registration:
#
#     systemctl --user stop iphonebridge-imessage
#     flatpak run app.openbubbles.OpenBubbles      # let it re-register, then quit
#     ~/.local/bin/ib-imessage --import-only \
#         --state-dir ~/.local/state/iphonebridge/imessage \
#         --import-from ~/.var/app/app.openbubbles.OpenBubbles/data/bluebubbles
#     systemctl --user start iphonebridge-imessage

[Service]
Type=simple
EnvironmentFile=-%h/.config/iphonebridge/local.env

# %t is XDG_RUNTIME_DIR (/run/user/UID): tmpfs-backed, per-user, and cleared
# on logout, which is right for a socket that grants the ability to send as
# this Apple ID.
ExecStart=%h/.local/bin/ib-imessage \
    --state-dir %S/iphonebridge/imessage \
    --socket %t/iphonebridge/imessage.sock

# ProtectSystem=strict below makes /run read-only, so the socket cannot live
# directly in %t. RuntimeDirectory carves out a writable subdirectory that
# systemd creates on start and removes on stop — which also means no stale
# socket to trip over after a crash.
RuntimeDirectory=iphonebridge
RuntimeDirectoryMode=0700

# The registration is the valuable, hard-to-replace thing here — it came from a
# one-time rented Mac and cannot be regenerated by this build. %S is
# ~/.local/state, which persists across reboots, unlike %t.
StateDirectory=iphonebridge/imessage
StateDirectoryMode=0700

# Apple drops connections routinely and rustpush reconnects internally, but if
# the process itself dies we want it back — a stopped helper means no inbound
# messages at all, silently.
Restart=always
RestartSec=10
# Don't hammer Apple if something is fundamentally broken (expired
# registration, say): five starts in five minutes and then stop, so the
# failure is visible in `systemctl --user status` instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
# rustpush's own logging is extremely chatty at info (it traces every mutex
# acquisition). warn keeps the journal usable while still surfacing
# registration-expiry warnings and connection problems.
Environment=RUST_LOG=warn,ib_imessage=info

# Hardening. This process holds Apple ID credentials and needs nothing but
# the network, its state directory and its socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ProtectHome=read-only would block writes to the state dir, so re-open it.
ReadWritePaths=%S/iphonebridge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# AF_UNIX for the control socket, AF_INET/AF_INET6 to reach Apple.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
